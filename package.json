{
  "name": "@fxri/moire",
  "version": "1.0.8",
  "private": true,
  "description": "轻量级 JS 前端辅助框架：枚举、工具、国际化、请求、字段与视图等常用能力。",
  "license": "Apache-2.0",
  "author": {
    "name": "唐启云",
    "email": "tqy@fxri.net",
    "url": "https://fxri.net:444/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxri-net/moire.git"
  },
  "bugs": {
    "url": "https://github.com/fxri-net/moire/issues"
  },
  "homepage": "https://fxri-net.github.io/moire/",
  "type": "module",
  "main": "dist/moire.min.js",
  "module": "dist/moire.esm.js",
  "types": "dist/types/entries/esm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/entries/esm.d.ts",
      "import": "./dist/moire.esm.js",
      "default": "./dist/moire.min.js"
    },
    "./*": "./*"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "TRADEMARK.md",
    "README.md"
  ],
  "scripts": {
    "build": "vite build --mode iife && vite build --mode esm && tsc -p tsconfig.build.json && node scripts/manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:examples": "tsc -p examples/tsconfig.json",
    "verify": "node scripts/verify.mjs",
    "changeset": "node scripts/toolkit.mjs changelog",
    "changelog:version": "node scripts/toolkit.mjs changelog version",
    "sync:changelog-doc": "node scripts/toolkit.mjs changelog doc",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "node scripts/guard-publish.mjs"
  },
  "keywords": [
    "moire",
    "frontend",
    "layui",
    "i18n",
    "fxri"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@10.34.4",
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "terser": "^5.44.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
