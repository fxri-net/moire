{
  "name": "moire",
  "version": "1.0.0",
  "description": "云纹框架",
  "type": "module",
  "main": "dist/moire.min.js",
  "module": "dist/moire.esm.js",
  "types": "dist/types/entries/esm.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/entries/esm.d.ts",
      "import": "./dist/moire.esm.js",
      "default": "./dist/moire.min.js"
    },
    "./*": "./*"
  },
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "build": "vite build --mode iife && vite build --mode esm && tsc -p tsconfig.build.json && node scripts/manifest.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:examples": "tsc -p examples/tsconfig.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "sync:changelog-doc": "node scripts/sync-changelog-doc.mjs",
    "release": "node scripts/release.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "author": {
    "name": "唐启云",
    "email": "tqy@fxri.net",
    "url": "https://fxri.net:444/"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://git.fxy.ink:444/fxri/develop/0001.base/moire.git"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "TRADEMARK.md",
    "README.md"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "terser": "^5.44.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
